generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model State {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cities    City[]
  colleges  College[]

  @@index([name])
  @@index([slug])
}

model City {
  id        String    @id @default(uuid())
  name      String
  slug      String
  stateId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  state     State     @relation(fields: [stateId], references: [id])
  colleges  College[]

  @@unique([stateId, slug])
  @@index([stateId])
  @@index([name])
}

model NavigationItem {
  id        String   @id @default(uuid())
  collegeId String
  label     String
  slug      String
  sectionId String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([collegeId, sortOrder])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@index([name])
  @@index([slug])
}

model College {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  shortName       String?
  logo            String?
  coverImage      String?
  description     String?
  establishedYear Int?
  collegeType     CollegeType
  status          CollegeStatus       @default(ACTIVE)
  website         String?
  email           String?
  phone           String?
  address         String?
  stateId         String
  cityId          String?
  verified        Boolean             @default(false)
  lastUpdated     DateTime            @default(now())
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  canonicalUrl    String?
  ogDescription   String?
  ogImage         String?
  ogTitle         String?
  seoKeywords     String?
  aisheCode       String?             @unique
  city            City?               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  state           State               @relation(fields: [stateId], references: [id])
  courses         CollegeCourse[]
  cutoffs         CollegeCutoff[]
  departments     CollegeDepartment[]
  photos          CollegePhoto[]
  placements      CollegePlacement[]
  questions       CollegeQuestion[]
  rankings        CollegeRanking[]
  fees            Fee[]
  infrastructure  Infrastructure?
  navigationItems NavigationItem[]
  reviews         Review[]
  applications    UserApplication[]
  shortlists      UserShortlist[]

  @@index([stateId])
  @@index([cityId])
  @@index([collegeType])
  @@index([status])
  @@index([verified])
  @@index([name])
}

model Course {
  id              String                 @id @default(uuid())
  name            String
  slug            String                 @unique
  shortName       String?
  degree          String?
  level           CourseLevel
  description     String?
  durationYears   Decimal?               @db.Decimal(4, 1)
  eligibility     String?
  averageFees     Decimal?               @db.Decimal(12, 2)
  careerOptions   String?
  status          CourseStatus           @default(ACTIVE)
  categoryId      String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  entryLevel      CourseEntryLevel?
  sourceCourseId  String?                @unique
  colleges        CollegeCourse[]
  category        Category               @relation(fields: [categoryId], references: [id])
  navigationItems CourseNavigationItem[]
  fees            Fee[]

  @@index([categoryId])
  @@index([level])
  @@index([entryLevel])
  @@index([status])
  @@index([name])
}

model CollegeCourse {
  id        String   @id @default(uuid())
  collegeId String
  courseId  String
  fees      Decimal? @db.Decimal(12, 2)
  seats     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duration  Decimal? @db.Decimal(4, 1)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([collegeId, courseId])
  @@index([collegeId])
  @@index([courseId])
}

model Fee {
  id           String    @id @default(uuid())
  sourceFeeId  String    @unique
  collegeId    String
  courseId     String?
  programName  String?
  feeType      String
  label        String?
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("INR")
  frequency    String?
  isRefundable Boolean   @default(false)
  academicYear String?
  sourceUrl    String?
  observedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  college      College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course       Course?   @relation(fields: [courseId], references: [id])

  @@index([collegeId])
  @@index([courseId])
  @@index([feeType])
  @@index([academicYear])
}

model Exam {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  shortName      String?
  conductingBody String?
  description    String?
  eligibility    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  applicationFee Decimal?        @db.Decimal(10, 2)
  examType       String?
  website        String?
  colleges       CollegeCutoff[]

  @@index([name])
  @@index([conductingBody])
}

model CollegeCutoff {
  id          String   @id @default(uuid())
  collegeId   String
  examId      String
  year        Int
  category    String
  gender      Gender?
  course      String?
  openingRank Int?
  closingRank Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([collegeId, examId, year, category, gender, course])
  @@index([collegeId])
  @@index([examId])
  @@index([year])
  @@index([category])
}

model Review {
  id                String   @id @default(uuid())
  collegeId         String
  rating            Int
  title             String?
  content           String
  isVerifiedStudent Boolean  @default(false)
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String?
  college           College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id])

  @@index([collegeId])
  @@index([rating])
  @@index([isPublished])
  @@index([createdAt])
}

model CollegeRanking {
  id            String        @id @default(uuid())
  collegeId     String
  year          Int
  rank          Int
  category      String
  rankingBody   String
  score         Decimal?      @db.Decimal(8, 2)
  totalColleges Int?
  status        RankingStatus @default(DRAFT)
  sourceUrl     String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  college       College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, year, rankingBody, category])
  @@index([collegeId])
  @@index([year])
  @@index([rankingBody])
  @@index([status])
}

model BoardExam {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  board       String?
  className   String?
  description String?
  resultDate  DateTime?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  examDate    DateTime?
  examYear    Int?
  officialUrl String?

  @@index([board])
  @@index([examYear])
  @@index([status])
}

model NewsArticle {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  excerpt        String?
  content        String
  coverImage     String?
  type           NewsType
  status         ContentStatus @default(DRAFT)
  sourceName     String?
  sourceUrl      String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  authorId       String?
  isFeatured     Boolean       @default(false)
  isTrending     Boolean       @default(false)
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?
  views          Int           @default(0)
  author         User?         @relation(fields: [authorId], references: [id])

  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([authorId])
  @@index([views])
}

model StudyAbroadDestination {
  id             String        @id @default(uuid())
  country        String
  slug           String        @unique
  description    String?
  coverImage     String?
  currency       String?
  averageTuition Decimal?      @db.Decimal(12, 2)
  popularCourses String?
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  admissionInfo  String?
  livingCost     Decimal?      @db.Decimal(12, 2)
  officialUrl    String?
  shortName      String?
  visaInfo       String?

  @@index([country])
  @@index([status])
}

model NewsletterSubscriber {
  id           String           @id @default(uuid())
  email        String           @unique
  status       NewsletterStatus @default(SUBSCRIBED)
  subscribedAt DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

model CollegeDepartment {
  id              String    @id @default(uuid())
  collegeId       String
  name            String
  slug            String
  description     String?
  hodName         String?
  establishedYear Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  college         College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  faculty         Faculty[]

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([name])
}

model Faculty {
  id              String            @id @default(uuid())
  departmentId    String
  name            String
  slug            String
  designation     String?
  qualification   String?
  specialization  String?
  profileImage    String?
  profileUrl      String?
  email           String?
  experienceYears Int?
  isPublished     Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  department      CollegeDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@index([name])
  @@index([isPublished])
}

model CollegePlacement {
  id                     String                      @id @default(uuid())
  collegeId              String
  year                   Int
  course                 String?
  placementType          PlacementType               @default(CAMPUS)
  totalStudents          Int?
  studentsPlaced         Int?
  averagePackage         Decimal?                    @db.Decimal(12, 2)
  medianPackage          Decimal?                    @db.Decimal(12, 2)
  highestPackage         Decimal?                    @db.Decimal(12, 2)
  totalOffers            Int?
  participatingCompanies Int?
  placementReportUrl     String?
  sourceUrl              String?
  status                 PlacementStatus             @default(DRAFT)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  college                College                     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  recruiters             CollegePlacementRecruiter[]

  @@unique([collegeId, year, course, placementType])
  @@index([collegeId])
  @@index([year])
  @@index([status])
}

model PlacementRecruiter {
  id         String                      @id @default(uuid())
  name       String                      @unique
  logo       String?
  website    String?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  placements CollegePlacementRecruiter[]

  @@index([name])
}

model CollegePlacementRecruiter {
  id          String             @id @default(uuid())
  placementId String
  recruiterId String
  placement   CollegePlacement   @relation(fields: [placementId], references: [id], onDelete: Cascade)
  recruiter   PlacementRecruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([placementId, recruiterId])
  @@index([placementId])
  @@index([recruiterId])
}

model CollegeQuestion {
  id         String          @id @default(uuid())
  collegeId  String
  question   String
  slug       String
  askerName  String?
  askerEmail String?
  status     QuestionStatus  @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  answers    CollegeAnswer[]
  college    College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([status])
  @@index([createdAt])
}

model CollegeAnswer {
  id           String          @id @default(uuid())
  questionId   String
  answer       String
  answererName String?
  answererRole String?
  isVerified   Boolean         @default(false)
  status       AnswerStatus    @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  question     CollegeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([status])
  @@index([createdAt])
}

model Infrastructure {
  id               String                   @id @default(uuid())
  collegeId        String                   @unique
  campusArea       String?
  campusType       String?
  description      String?
  hostel           Boolean                  @default(false)
  library          Boolean                  @default(false)
  laboratories     Boolean                  @default(false)
  sports           Boolean                  @default(false)
  cafeteria        Boolean                  @default(false)
  auditorium       Boolean                  @default(false)
  medical          Boolean                  @default(false)
  wifi             Boolean                  @default(false)
  itInfrastructure Boolean                  @default(false)
  transportation   Boolean                  @default(false)
  gym              Boolean                  @default(false)
  otherFacilities  String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  college          College                  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  facilities       InfrastructureFacility[]
}

model InfrastructureFacility {
  id               String         @id @default(uuid())
  infrastructureId String
  name             String
  description      String?
  available        Boolean        @default(true)
  sortOrder        Int            @default(0)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  infrastructure   Infrastructure @relation(fields: [infrastructureId], references: [id], onDelete: Cascade)

  @@index([infrastructureId])
  @@index([infrastructureId, sortOrder])
}

model CollegePhoto {
  id          String   @id @default(uuid())
  collegeId   String
  imageUrl    String
  title       String?
  description String?
  category    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([collegeId, sortOrder])
}

model CourseNavigationItem {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([courseId, sortOrder])
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  phone        String?
  role         UserRole          @default(USER)
  newsArticles NewsArticle[]
  reviews      Review[]
  applications UserApplication[]
  sessions     UserSession[]
  shortlists   UserShortlist[]

  @@index([email])
  @@index([role])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserShortlist {
  id        String   @id @default(uuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model UserApplication {
  id          String                @id @default(uuid())
  userId      String
  collegeId   String
  status      UserApplicationStatus @default(INTERESTED)
  courseName  String?
  notes       String?
  appliedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  phoneNumber String
  college     College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
  @@index([status])
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
  PUBLIC
  DEEMED
  AUTONOMOUS
  OTHER
}

enum CollegeStatus {
  ACTIVE
  INACTIVE
}

enum CourseLevel {
  UG
  PG
  DIPLOMA
  PHD
  CERTIFICATE
  INTEGRATED
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum CourseEntryLevel {
  AFTER_10TH
  AFTER_12TH
  AFTER_DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  PHD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RankingStatus {
  DRAFT
  PUBLISHED
}

enum NewsType {
  EXAM_ALERT
  COLLEGE_ALERT
  ADMISSION_ALERT
  EDUCATION_NEWS
  RESULT
  CAREER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum QuestionStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AnswerStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum PlacementType {
  CAMPUS
  INTERNSHIP
  OFF_CAMPUS
}

enum PlacementStatus {
  DRAFT
  PUBLISHED
}

enum UserApplicationStatus {
  INTERESTED
  APPLIED
  IN_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum UserRole {
  USER
  ADMIN
}
