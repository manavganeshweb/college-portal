generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum CollegeType {
  GOVERNMENT
  PRIVATE
  PUBLIC
  DEEMED
  AUTONOMOUS
}

enum CollegeStatus {
  ACTIVE
  INACTIVE
}

enum CourseLevel {
  UG
  PG
  DIPLOMA
  PHD
  CERTIFICATE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum CourseEntryLevel {
  AFTER_10TH
  AFTER_12TH
  AFTER_DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  PHD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RankingStatus {
  DRAFT
  PUBLISHED
}

enum NewsType {
  EXAM_ALERT
  COLLEGE_ALERT
  ADMISSION_ALERT
  EDUCATION_NEWS
  RESULT
  CAREER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum QuestionStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AnswerStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum PlacementType {
  CAMPUS
  INTERNSHIP
  OFF_CAMPUS
}

enum PlacementStatus {
  DRAFT
  PUBLISHED
}

enum UserApplicationStatus {
  INTERESTED
  APPLIED
  IN_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}


enum UserRole {
  USER
  ADMIN
}

// ============================================================
// STATE
// ============================================================

model State {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  cities   City[]
  colleges College[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([slug])
}

// ============================================================
// CITY
// ============================================================

model City {
  id        String    @id @default(uuid())
  name      String
  slug      String
  stateId   String
  state     State     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  colleges  College[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([stateId, slug])
  @@index([stateId])
  @@index([name])
}

// ============================================================
// CATEGORY
// ============================================================
model NavigationItem {
  id String @id @default(uuid())

  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  label     String
  slug      String
  sectionId String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([collegeId, sortOrder])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([slug])
}

// ============================================================
// COLLEGE
// ============================================================

model College {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  shortName String?

  logo            String?
  coverImage      String?
  description     String?
  navigationItems NavigationItem[]
  establishedYear Int?
  collegeType     CollegeType
  shortlists      UserShortlist[]
  applications    UserApplication[]

  website String?
  email   String?
  phone   String?
  address String?

  verified Boolean       @default(false)
  status   CollegeStatus @default(ACTIVE)

  lastUpdated DateTime @default(now())

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  infrastructure Infrastructure?
  photos         CollegePhoto[]
  stateId        String
  cityId         String

  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)
  city  City  @relation(fields: [cityId], references: [id], onDelete: Restrict)

  courses  CollegeCourse[]
  cutoffs  CollegeCutoff[]
  reviews  Review[]
  rankings CollegeRanking[]

  departments CollegeDepartment[]
  questions   CollegeQuestion[]
  placements  CollegePlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stateId])
  @@index([cityId])
  @@index([collegeType])
  @@index([status])
  @@index([verified])
  @@index([name])
}

// ============================================================
// COURSE
// ============================================================

model Course {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  shortName String?

  degree String?
  level  CourseLevel

  entryLevel CourseEntryLevel?

  description String?

  durationYears Decimal? @db.Decimal(4, 1)

  eligibility String?
  averageFees Decimal? @db.Decimal(12, 2)

  careerOptions String?

  navigationItems CourseNavigationItem[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  colleges CollegeCourse[]

  status CourseStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([level])
  @@index([entryLevel])
  @@index([status])
  @@index([name])
}

// ============================================================
// COLLEGE COURSE
// ============================================================

model CollegeCourse {
  id String @id @default(uuid())

  collegeId String
  courseId  String

  fees     Decimal? @db.Decimal(12, 2)
  seats    Int?
  duration Decimal? @db.Decimal(4, 1)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, courseId])
  @@index([collegeId])
  @@index([courseId])
}

// ============================================================
// EXAM
// ============================================================

model Exam {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  shortName String?

  description String?

  conductingBody String?
  examType       String?

  eligibility    String?
  applicationFee Decimal? @db.Decimal(10, 2)

  website String?

  colleges CollegeCutoff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([conductingBody])
}

// ============================================================
// COLLEGE CUTOFF
// ============================================================

model CollegeCutoff {
  id String @id @default(uuid())

  collegeId String
  examId    String

  year Int

  category String
  gender   Gender?

  course String?

  openingRank Int?
  closingRank Int?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, examId, year, category, gender, course])
  @@index([collegeId])
  @@index([examId])
  @@index([year])
  @@index([category])
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id String @id @default(uuid())

  collegeId String

  rating  Int
  title   String?
  content String

  isVerifiedStudent Boolean @default(false)
  isPublished       Boolean @default(false)
  userId            String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([rating])
  @@index([isPublished])
  @@index([createdAt])
}

// ============================================================
// COLLEGE RANKING
// ============================================================

model CollegeRanking {
  id String @id @default(uuid())

  collegeId String

  year Int
  rank Int

  category    String
  rankingBody String

  score         Decimal? @db.Decimal(8, 2)
  totalColleges Int?

  sourceUrl   String?
  publishedAt DateTime?

  status RankingStatus @default(DRAFT)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, year, rankingBody, category])
  @@index([collegeId])
  @@index([year])
  @@index([rankingBody])
  @@index([status])
}

// ============================================================
// BOARD EXAM
// ============================================================

model BoardExam {
  id String @id @default(uuid())

  name String
  slug String @unique

  board     String?
  className String?

  examYear Int?

  examDate   DateTime?
  resultDate DateTime?

  description String?

  officialUrl String?

  status ContentStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([board])
  @@index([examYear])
  @@index([status])
}

// ============================================================
// NEWS ARTICLE
// ============================================================

model NewsArticle {
  id String @id @default(uuid())

  title String
  slug  String @unique

  excerpt String?
  content String

  coverImage String?

  type NewsType

  sourceName String?
  sourceUrl  String?

  authorId String?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime?

  status ContentStatus @default(DRAFT)

  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)

  views Int @default(0)

  seoTitle       String?
  seoDescription String?
  seoKeywords   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([authorId])
  @@index([views])
}

// ============================================================
// STUDY ABROAD DESTINATION
// ============================================================

model StudyAbroadDestination {
  id String @id @default(uuid())

  country String
  slug    String @unique

  shortName String?

  description String?

  coverImage String?

  popularCourses String?

  averageTuition Decimal? @db.Decimal(12, 2)
  livingCost     Decimal? @db.Decimal(12, 2)

  currency String?

  visaInfo      String?
  admissionInfo String?

  officialUrl String?

  status ContentStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([status])
}

// ============================================================
// NEWSLETTER SUBSCRIBER
// ============================================================

model NewsletterSubscriber {
  id String @id @default(uuid())

  email String @unique

  status NewsletterStatus @default(SUBSCRIBED)

  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// ============================================================
// COLLEGE DEPARTMENT
// ============================================================

model CollegeDepartment {
  id String @id @default(uuid())

  collegeId String

  name String
  slug String

  description String?
  hodName     String?

  establishedYear Int?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  faculty Faculty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([name])
}

// ============================================================
// FACULTY
// ============================================================

model Faculty {
  id String @id @default(uuid())

  departmentId String

  name String
  slug String

  designation    String?
  qualification  String?
  specialization String?

  profileImage String?
  profileUrl   String?

  email String?

  experienceYears Int?

  isPublished Boolean @default(false)

  department CollegeDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@index([name])
  @@index([isPublished])
}

// ============================================================
// COLLEGE PLACEMENT
// ============================================================

model CollegePlacement {
  id String @id @default(uuid())

  collegeId String

  year   Int
  course String?

  placementType PlacementType @default(CAMPUS)

  totalStudents  Int?
  studentsPlaced Int?

  averagePackage Decimal? @db.Decimal(12, 2)
  medianPackage  Decimal? @db.Decimal(12, 2)
  highestPackage Decimal? @db.Decimal(12, 2)

  totalOffers            Int?
  participatingCompanies Int?

  placementReportUrl String?
  sourceUrl          String?

  status PlacementStatus @default(DRAFT)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  recruiters CollegePlacementRecruiter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, year, course, placementType])
  @@index([collegeId])
  @@index([year])
  @@index([status])
}

// ============================================================
// PLACEMENT RECRUITER
// ============================================================

model PlacementRecruiter {
  id String @id @default(uuid())

  name String @unique

  logo    String?
  website String?

  placements CollegePlacementRecruiter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ============================================================
// COLLEGE PLACEMENT RECRUITER
// ============================================================

model CollegePlacementRecruiter {
  id String @id @default(uuid())

  placementId String
  recruiterId String

  placement CollegePlacement   @relation(fields: [placementId], references: [id], onDelete: Cascade)
  recruiter PlacementRecruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@unique([placementId, recruiterId])
  @@index([placementId])
  @@index([recruiterId])
}

// ============================================================
// COLLEGE QUESTION
// ============================================================

model CollegeQuestion {
  id String @id @default(uuid())

  collegeId String

  question String
  slug     String

  askerName  String?
  askerEmail String?

  status QuestionStatus @default(PENDING)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  answers CollegeAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, slug])
  @@index([collegeId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// COLLEGE ANSWER
// ============================================================

model CollegeAnswer {
  id String @id @default(uuid())

  questionId String

  answer String

  answererName String?
  answererRole String?

  isVerified Boolean @default(false)

  status AnswerStatus @default(PENDING)

  question CollegeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// INFRASTRUCTURE
// ============================================================

model Infrastructure {
  id String @id @default(uuid())

  collegeId String  @unique
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  campusArea  String?
  campusType  String?
  description String?

  hostel           Boolean @default(false)
  library          Boolean @default(false)
  laboratories     Boolean @default(false)
  sports           Boolean @default(false)
  cafeteria        Boolean @default(false)
  auditorium       Boolean @default(false)
  medical          Boolean @default(false)
  wifi             Boolean @default(false)
  itInfrastructure Boolean @default(false)
  transportation   Boolean @default(false)
  gym              Boolean @default(false)

  otherFacilities String?

  facilities InfrastructureFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// INFRASTRUCTURE FACILITY
// ============================================================

model InfrastructureFacility {
  id String @id @default(uuid())

  infrastructureId String
  infrastructure   Infrastructure @relation(fields: [infrastructureId], references: [id], onDelete: Cascade)

  name        String
  description String?

  available Boolean @default(true)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([infrastructureId])
  @@index([infrastructureId, sortOrder])
}

// ============================================================
// COLLEGE PHOTOS
// ============================================================

// ============================================================
// COLLEGE PHOTOS
// ============================================================

model CollegePhoto {
  id String @id @default(uuid())

  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  imageUrl    String
  title       String?
  description String?
  category    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([collegeId, sortOrder])
}

model CourseNavigationItem {
  id        String  @id @default(uuid())
  courseId  String
  title     String
  slug      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([courseId, sortOrder])
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  avatar       String?
  role         UserRole @default(USER)

  sessions     UserSession[]
  shortlists   UserShortlist[]
  applications UserApplication[]
  reviews      Review[]
  newsArticles NewsArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}
// ============================================================
// USER SESSION
// ============================================================

model UserSession {
  id String @id @default(uuid())

  userId    String
  tokenHash String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserShortlist {
  id String @id @default(uuid())

  userId    String
  collegeId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model UserApplication {
  id String @id @default(uuid())

  userId      String
  collegeId   String
  phoneNumber String

  status UserApplicationStatus @default(INTERESTED)

  courseName String?
  notes      String?

  appliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
  @@index([status])
}


